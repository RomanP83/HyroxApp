# ── Supabase ────────────────────────────────────────────────────────────────
# Public (browser-safe) values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the browser. Used by webhooks / engine to write
# athlete_state and plan_adjustments (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe (Section 2 / 4: one-time "Race Cycle" purchase) ──────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price id for the one-time race_cycle product (e.g. 79.99 EUR benchmark)
STRIPE_RACE_CYCLE_PRICE_ID=price_...

# ── Telegram (Section 4: 4-button quick-log adherence loop) ─────────────────
TELEGRAM_BOT_TOKEN=123456:ABC...
# Bot username (without @) — used to render the "Connect Telegram" deep link.
TELEGRAM_BOT_USERNAME=YourHyroxBot
# Shared secret Telegram sends back in the webhook header (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your-random-secret
# HMAC secret for signed deep-links that connect a chat to an athlete profile
TELEGRAM_DEEPLINK_SECRET=your-random-secret

# ── Cron (Section 5 Layer 2: nightly macro-guardrails) ──────────────────────
# Bearer token guarding POST /api/cron/macro (Vercel Cron sends it).
CRON_SECRET=your-random-secret

# ── AI coach (post-session Trainingsfeedback) ───────────────────────────────
# Optional. When set, Claude rewrites the deterministic coach text in a warmer
# voice (numbers/verdicts stay engine-computed). Unset = deterministic text.
ANTHROPIC_API_KEY=sk-ant-...

# ── Event-calendar scraper (scripts/scrape_races.py, optional) ──────────────
FIRECRAWL_API_KEY=fc-...

# ── Email fallback for check-ins (Phase D3, optional) ───────────────────────
# When Telegram isn't connected, the evening check-in arrives via Resend.
RESEND_API_KEY=re_...
EMAIL_FROM="Hyrox Hub <coach@yourdomain.com>"
