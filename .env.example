# ── Supabase ────────────────────────────────────────────────────────────────
# Public (browser-safe) values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the browser. Used by webhooks / engine to write
# athlete_state and plan_adjustments (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Training time zone: which calendar day "today" is for the plan, check-ins
# and auto-logged runs.
APP_TIME_ZONE=Europe/Berlin


# ── Telegram (Section 4: 4-button quick-log adherence loop) ─────────────────
TELEGRAM_BOT_TOKEN=123456:ABC...
# Bot username (without @) — used to render the "Connect Telegram" deep link.
TELEGRAM_BOT_USERNAME=YourHyroxBot
# Shared secret Telegram sends back in the webhook header (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your-random-secret
# HMAC secret for signed deep-links that connect a chat to an athlete profile
TELEGRAM_DEEPLINK_SECRET=your-random-secret

# ── Cron (Section 5 Layer 2: nightly macro-guardrails) ──────────────────────
# Bearer token guarding POST /api/cron/macro (Vercel Cron sends it). Doubles as
# the operator secret for /api/admin/** and the /admin/knowledge review UI.
CRON_SECRET=your-random-secret

# ── AI coach (post-session Trainingsfeedback) ───────────────────────────────
# Optional. When set, Claude rewrites the deterministic coach text in a warmer
# voice (numbers/verdicts stay engine-computed). Unset = deterministic text.
# Also required by the knowledge pipeline (docs/knowledge-pipeline.md), which
# reads uploaded PDFs and proposes library blocks / calibration constants.
ANTHROPIC_API_KEY=sk-ant-...

# ── AI coach reviews + suggestions (Gemini, optional) ──────────────────────
# When set, the "AI coach" card on /plan reviews the last three weeks and
# proposes up to three changes (move / easier / harder / skip). The engine
# validates every proposal; nothing changes until the athlete taps Apply.
# The Sunday weekly review also carries the coach's text. Training data is
# sent to Google — see docs/anleitung.md section 4.
GEMINI_API_KEY=
# Optional: model id (default in src/lib/gemini.ts) and the language of the
# review text (default German).
GEMINI_MODEL=
AI_COACH_LANGUAGE=German

# ── Event-calendar scraper (scripts/scrape_races.py, optional) ──────────────
FIRECRAWL_API_KEY=fc-...

# ── Email fallback for check-ins (Phase D3, optional) ───────────────────────
# When Telegram isn't connected, the evening check-in arrives via Resend.
RESEND_API_KEY=re_...
EMAIL_FROM="Hyrox Hub <coach@yourdomain.com>"

# ── Strava sync — runs only (Phase C2, optional) ────────────────────────────
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=...
# Token you choose when registering the webhook subscription with Strava
STRAVA_WEBHOOK_VERIFY_TOKEN=your-random-secret

# ── Garmin sync — runs only (optional) ──────────────────────────────────────
# From the Garmin Connect Developer Program app; the Push webhook URL
# (/api/garmin/webhook) is registered in the Garmin developer portal.
GARMIN_CLIENT_ID=...
GARMIN_CLIENT_SECRET=...
# Required for every webhook request. Register the Push URL as:
# https://your-app.example/api/garmin/webhook?token=<this value>
GARMIN_WEBHOOK_SECRET=your-random-secret
